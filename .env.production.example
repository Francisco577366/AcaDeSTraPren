# =====================================================================
#  ENTORNO DE PRODUCCION  -  copia esto a .env.production
# =====================================================================
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production NO entra al repositorio. Aqui dentro va la cadena de Atlas,
# que lleva usuario y contrasena, y el secreto con el que se firman los
# tokens. Quien tenga ese secreto puede emitirse uno de administrador sin
# pasar por el login.
#
# Para generar los secretos:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Lo que tengas aqui es lo mismo que hay que poner en el panel de Vercel.

# ---- Base: MongoDB Atlas ----
# La cadena completa, con usuario y clave. mongodb+srv:// ya cifra de serie;
# el arranque rechaza una URI local o sin cifrar cuando NODE_ENV=production
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# El nombre de la base DENTRO del cluster. Ponle uno distinto al que uses para
# probar: es la ultima barrera si alguna vez se cruzan las cadenas
DB_NAME=academia
# Conexiones por instancia. En Vercel (serverless) 2; en un servidor propio 10
DB_POOL_MAX=2

# ---- Secretos ----
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cuenta del dia a dia. Clave distinta de la del administrador y de 12
# caracteres como minimo: el arranque lo comprueba. Dejalas vacias si solo
# quieres la cuenta de administrador
USUARIO_NAME=Usuario
USUARIO_EMAIL=
USUARIO_PASSWORD=
# Quien atiende el mostrador de la libreria: vende, cobra lo pendiente y
# ajusta inventario. No ve alumnos, ni mensualidades, ni nomina, ni el
# alquiler, ni nada mas de la academia. Sin contrasena NO se crea
LIBRERIA_NAME=Libreria
LIBRERIA_EMAIL=libreria@academia.com
LIBRERIA_PASSWORD=
# Llave de las tareas programadas. Sin ella /api/cron queda CERRADA, no
# abierta. En Vercel se llama asi y la plataforma la manda sola
CRON_SECRET=

# ---- Dominios ----
# Exactamente el origen del frontend, sin barra final y sin ruta.
# No se admite * ni http:// : el frontend vive en otro dominio
CORS_ORIGIN=https://tu-usuario.github.io
# Donde esta el API. Entra en la CSP del frontend al construirlo
VITE_API_URL=https://tu-api.vercel.app/api
# GitHub Pages sirve el proyecto en /nombre-del-repositorio/
VITE_BASE_PATH=/acadestrapren/
# Puerto del frontend cuando se sirve desde este compose
FRONTEND_PORT=8080

# ---- Seguridad ----
TRUST_PROXY=1
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=8

# ---- Academia ----
CURRENCY=USD
BASE_MONTHLY_FEE=70
BASE_ENROLLMENT_FEE=0
MONTHLY_DUE_DAY=5
AUTO_MONTHLY_CHARGES=true
AUTO_CHARGES_CHECK_HOURS=6
BASE_RENT=0
RENT_CURRENCY=USD
RENT_DUE_DAY=5
BASE_STUDENT_RATE=5
WEEKS_PER_MONTH=4
DAYS_PER_WEEK=5
LIBRARY_CURRENCY=VES
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
EXCHANGE_RATE_TTL_MINUTES=360
ACADEMY_START_DATE=2026-09-15
# Zona del sistema (logs, reloj del contenedor)
TZ=America/Caracas
# Zona de la ACADEMIA: de aqui sale en que dia vive el negocio. Va aparte
# de TZ porque las plataformas fijan TZ en UTC y no dejan cambiarla
ACADEMY_TZ=America/Caracas

# =====================================================================
#  LA DEMOSTRACION  -  la misma base, datos separados
# =====================================================================
#
# La cuenta PUBLICA de demostracion, la del enlace de LinkedIn.
#
# Comparte base con la academia, pero no comparte datos: cada registro lleva
# una marca y cada consulta la filtra, asi que esta cuenta ve SOLO lo que ella
# misma crea. Entra y no hay nada; va inscribiendo sus alumnos, vendiendo en
# su libreria y anotando sus gastos, y ve la aplicacion responder a lo suyo.
#
# Lo que ve tampoco ensucia lo tuyo: sus registros no entran en tus totales ni
# gastan la numeracion de tus recibos (los suyos empiezan en REC-1000001).
#
# El filtro no se escribe en cada consulta —son cuarenta agregaciones y se
# olvidaria una— sino que lo ponen los modelos en todas a la vez. Lo prueba
# `npm run probar:aislamiento`, y conviene correrlo si tocas una consulta.
DEMO_NAME=Visita
DEMO_EMAIL=
DEMO_PASSWORD=

# Lo unico que no puede es cambiar su propia contrasena: la comparten todos
# los visitantes, y el primero que la cambiara dejaria fuera a los demas.
#
# Para barrer lo que vayan dejando:
#   npm run atlas:demo           lo borra todo y la deja vacia
#   npm run atlas:demo -- datos  le deja 18 alumnos inventados
#
# Y en el FRONTEND, dos variables, SOLO para el aviso de bienvenida que da
# las credenciales a quien llega. Como el frontend lo construye GitHub
# Actions, se crean en
#   Settings > Secrets and variables > Actions > pestana Variables
#
#   VITE_DEMO_EMAIL     el mismo correo que DEMO_EMAIL
#   VITE_DEMO_PASSWORD  la misma clave que DEMO_PASSWORD
#
# En Variables y no en Secrets a proposito: son publicas, se comparten en un
# enlace. Si no se definen, el aviso no se pinta y nada mas.
