# =====================================================================
#  ENTORNO DE PRODUCCION  -  copia esto a .env.production
# =====================================================================
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production NO entra al repositorio. Aqui dentro va la cadena de Atlas,
# que lleva usuario y contrasena, y el secreto con el que se firman los
# tokens. Quien tenga ese secreto puede emitirse uno de administrador sin
# pasar por el login.
#
# Para generar los secretos:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Lo que tengas aqui es lo mismo que hay que poner en el panel de Vercel.

# ---- Base: MongoDB Atlas ----
# La cadena completa, con usuario y clave. mongodb+srv:// ya cifra de serie;
# el arranque rechaza una URI local o sin cifrar cuando NODE_ENV=production
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# El nombre de la base DENTRO del cluster. Ponle uno distinto al que uses para
# probar: es la ultima barrera si alguna vez se cruzan las cadenas
DB_NAME=academia
# Conexiones por instancia. En Vercel (serverless) 2; en un servidor propio 10
DB_POOL_MAX=2

# ---- Secretos ----
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cuenta del dia a dia. Clave distinta de la del administrador y de 12
# caracteres como minimo: el arranque lo comprueba. Dejalas vacias si solo
# quieres la cuenta de administrador
USUARIO_NAME=Usuario
USUARIO_EMAIL=
USUARIO_PASSWORD=
# Llave de las tareas programadas. Sin ella /api/cron queda CERRADA, no
# abierta. En Vercel se llama asi y la plataforma la manda sola
CRON_SECRET=

# ---- Dominios ----
# Exactamente el origen del frontend, sin barra final y sin ruta.
# No se admite * ni http:// : el frontend vive en otro dominio
CORS_ORIGIN=https://tu-usuario.github.io
# Donde esta el API. Entra en la CSP del frontend al construirlo
VITE_API_URL=https://tu-api.vercel.app/api
# GitHub Pages sirve el proyecto en /nombre-del-repositorio/
VITE_BASE_PATH=/acadestrapren/
# Puerto del frontend cuando se sirve desde este compose
FRONTEND_PORT=8080

# ---- Seguridad ----
TRUST_PROXY=1
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=8

# ---- Academia ----
CURRENCY=USD
BASE_MONTHLY_FEE=70
BASE_ENROLLMENT_FEE=0
MONTHLY_DUE_DAY=5
AUTO_MONTHLY_CHARGES=true
AUTO_CHARGES_CHECK_HOURS=6
BASE_RENT=0
RENT_CURRENCY=USD
RENT_DUE_DAY=5
BASE_STUDENT_RATE=5
WEEKS_PER_MONTH=4
DAYS_PER_WEEK=5
LIBRARY_CURRENCY=VES
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
EXCHANGE_RATE_TTL_MINUTES=360
ACADEMY_START_DATE=2026-09-15
TZ=America/Caracas

# =====================================================================
#  DESPLIEGUE DE DEMOSTRACION  -  OTRO .env, OTRA BASE, OTRO despliegue
# =====================================================================
#
# La demo NO comparte base con la academia. No es una preferencia: una cuenta
# publica contra la base real pondria los nombres de los alumnos, sus
# mensualidades y los retiros del dueno al alcance de cualquiera.
#
# Por eso el arranque se niega a crear la cuenta de demostracion si DB_NAME no
# dice "demo". Para montarla, copia este fichero a .env.demo y cambia:
#
#   DB_NAME=academia_demo          <- el nombre tiene que llevar "demo"
#   MONGODB_URI=<el mismo cluster de Atlas, o uno aparte>
#   CORS_ORIGIN=<el dominio de la demo>
#   DEMO_EMAIL / DEMO_PASSWORD     <- publicas, van en el enlace de LinkedIn
#
# Y siembra los datos inventados:
#   DB_NAME=academia_demo npm run demo:sembrar
#
# La cuenta demo ve y prueba lo mismo que un usuario, pero no puede borrar, ni
# anular, ni cambiar su propia contrasena: es compartida, y el primer
# visitante que la cambiara dejaria fuera a todos los demas.
#
# DEMO_NAME=Visita
# DEMO_EMAIL=
# DEMO_PASSWORD=
