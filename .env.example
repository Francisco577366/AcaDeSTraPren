# =====================================================================
#  ENTORNO LOCAL  -  copia esto a .env
# =====================================================================
#
# Para trabajar en el equipo. La base es el Mongo del docker-compose.yml, y su
# direccion NO se pone aqui: va escrita en el propio compose para que este
# entorno no pueda apuntar a Atlas por un descuido en una variable.
#
# Todos los valores de abajo son publicos, porque este fichero viaja en el
# repositorio. Valen para desarrollo y NO valen para produccion: con
# NODE_ENV=production el servidor los detecta y se niega a arrancar.
#
# Para produccion, mira .env.production.example

# ---- Puertos (atados a 127.0.0.1 por el compose) ----
BACKEND_PORT=4000
FRONTEND_PORT=5173
DB_PORT=27017
MONGO_UI_PORT=8081

# ---- Base ----
DB_NAME=academia

# ---- Backend ----
JWT_SECRET=solo-para-desarrollo-local-no-sirve-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Carga src/seed/data.json cuando la base aparece vacia
SEED_ON_START=true
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@academia.com
ADMIN_PASSWORD=Admin123*
# Cuenta del dia a dia: alumnos, cobros y libreria. No ve sueldos, ni el
# alquiler, ni los retiros personales, ni la ganancia. Si no pones
# contrasena NO se crea: una cuenta con clave conocida es peor que no tenerla
USUARIO_NAME=Usuario
USUARIO_EMAIL=usuario@academia.com
USUARIO_PASSWORD=Usuario123*

# ---- Frontend ----
VITE_API_URL=http://localhost:4000/api

# ---- Academia ----
CURRENCY=USD
# Mensualidad estandar que propone el alta de alumnos
BASE_MONTHLY_FEE=70
# Inscripcion que propone el alta de alumnos; 0 = no se cobra
BASE_ENROLLMENT_FEE=0
# Dia del mes en que vence la mensualidad
MONTHLY_DUE_DAY=5
# Cada mes nuevo emite la mensualidad a todos los alumnos activos sin pulsar
# nada, asi que el mes arranca con todos en pendiente. false = solo a mano
AUTO_MONTHLY_CHARGES=true
# Cada cuantas horas se comprueba si ya cambio el mes
AUTO_CHARGES_CHECK_HOURS=6
# Alquiler mensual del local: monto, moneda y dia de vencimiento
BASE_RENT=0
RENT_CURRENCY=USD
RENT_DUE_DAY=5
# Lo que cobra un profesor por cada alumno a su cargo
BASE_STUDENT_RATE=5
# Semanas por mes para pasar el pago semanal del profesor a mensual
WEEKS_PER_MONTH=4
# Dias de trabajo por semana; reparte el pago semanal en pago por dia
DAYS_PER_WEEK=5
# La libreria cobra en bolivares
LIBRARY_CURRENCY=VES
# De donde se lee la tasa oficial del BCV (bolivares por dolar)
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
EXCHANGE_RATE_TTL_MINUTES=360
# Dia en que abrio la academia: su mes se paga solo por lo trabajado
ACADEMY_START_DATE=2026-09-15
TZ=America/Caracas
